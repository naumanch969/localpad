{
  "manifest_version": 3,
  "name": "LocalPad",
  "version": "1.0.0",
  "description": "Developer dashboard for managing local projects and ports with ease.",
  "author": "LocalPad Developer",
  "action": {
    "default_popup": "index.html",
    "default_title": "LocalPad - Manage local ports",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
